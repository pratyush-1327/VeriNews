# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=verinews

# Backend URLs (Default for Docker Compose network)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/verinews
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/verinews
REDIS_URL=redis://redis:6379/0

# For local development outside docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/verinews
# SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/verinews
# REDIS_URL=redis://localhost:6379/0

# App Settings
PROJECT_NAME="VeriNews API"
API_V1_STR=/api/v1
ENVIRONMENT=development

# Future AI / Search API keys (for Phase 2 & 3)
GEMINI_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
TAVILY_API_KEY=
